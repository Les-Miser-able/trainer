.venv/
__pycache__/
/raw/

# Keep trained checkpoints and their supporting metadata/results.
/runs/**
!/runs/*/
!/runs/*/*/
!/runs/*/*/best.keras
!/runs/*/*/classes.json
!/runs/*/*/preprocessing.json
!/runs/*/*/training_config.json
!/runs/*/*/model_summary.txt
!/runs/*/*/test_metrics.json
!/runs/*/*/history.json
!/runs/*/*/history.csv
!/runs/*/*/epoch_times.json
!/runs/*/*/confusion_matrix*.csv
!/runs/*/*/confusion_matrix*.png
*.pyc
node_modules

# Local settings and secrets.
.vscode/
.idea/
.env
.env.*
!.env.example
*.log
.DS_Store
Thumbs.db
.pytest_cache/
.coverage
htmlcov/

# Source media, prepared datasets, and caches stay local; keep scaffolding.
/data/**
!/data/raw/
!/data/raw/*/
!/data/raw/*/.gitkeep
!/data/processed/
!/data/processed/default/
!/data/processed/default/.gitkeep
!/data/processed/augmented/
!/data/processed/augmented/.gitkeep
!/data/cache/
!/data/cache/.gitkeep
*.egg-info/
build/

# Browser source, exported models, detector, and catalog are tracked.
# Vendor libraries and the shell asset list are recreated by npm run setup.
/pwa-sample/dist/vendor/
/pwa-sample/dist/shell-assets.json

# Legacy root npm files only install an unrelated npm package named numpy.
# Python dependencies use requirements.txt; the PWA has its own npm manifest.
/package.json
/package-lock.json

# Generated augmentation artifacts; retain scaffolding.
/reports/augmentation/previews/*
!/reports/augmentation/previews/.gitkeep
/reports/augmentation/reports/*
!/reports/augmentation/reports/.gitkeep
